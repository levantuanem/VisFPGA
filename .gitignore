# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ipynb_checkpoints/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# --- Data (large, not committed — see docs/ for how to regenerate) ---
data/raw/*
data/processed/*
data/splits/*
data/calibration/*
!data/**/.gitkeep

# --- Model artifacts (large binaries) ---
models/checkpoints/*
models/onnx/*
models/quantized/*
models/tensorrt/*
!models/**/.gitkeep

# --- Results (regenerable from experiments) ---
results/raw/*
results/figures/*
results/logs/*
!results/**/.gitkeep
# Keep summary tables — these are small and worth versioning for the report
!results/tables/*.csv

# --- FPGA build artifacts (large, regenerated by Vivado/Vitis) ---
fpga/**/build/
fpga/**/*.log
fpga/**/*.jou
fpga/**/*.dcp
fpga/**/*.bit
fpga/**/*.afi
fpga/**/.Xil/

# --- Benchmarks output ---
benchmarks/**/*.json
benchmarks/**/*.csv
!benchmarks/**/.gitkeep

# --- Notebooks: strip output before commit where possible ---
notebooks/*.ipynb

# --- Web ---
web/frontend/node_modules/
web/frontend/dist/
web/backend/__pycache__/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Secrets ---
.env
*.pem
aws_credentials*